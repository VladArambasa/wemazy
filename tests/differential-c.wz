// The C-like way of writing Wemazy Script: { } blocks, var, ++, &&, methods...
// Every line printed here must be the same in JavaScript and in PHP.
server function t() {
    var a = 5;
    var b = 2, c = "x";
    print a + b;
    print c;
    a++;
    print a;
    a--;
    a -= 2;
    print a;
    a += 10;
    a *= 3;
    print a;
    a /= 4;
    print a;
    a %= 4;
    print a;
    c &= "y";
    print c;
    ++a;
    --b;
    print a + "," + b;

    // decisions
    if (a > 1) {
        print "a > 1";
    } else if (a == 1) {
        print "a is 1";
    } else {
        print "small";
    }
    if (a == 999) print "no"; else print "yes";
    if (a != 3 && b == 1) print "and";
    if (a == 3 || b == 7) print "or";
    if (!(a == 3)) print "not";
    if (!false) print "bang";
    print a > 2 ? "big" : "small";
    print a === 3;
    print a !== 3;
    print null == nothing;
    if (a > 2)
    {
        print "allman";
    }
    else
    {
        print "allman else";
    }

    // loops
    var s = 0;
    for (var i = 1; i <= 10; i++) {
        if (i % 2 == 0) continue;
        if (i > 7) break;
        s += i;
    }
    print s;
    for (var j = 10; j > 0; j -= 3) print j;
    for (k = 1 to 3) print k * k;
    var n = 0;
    while (n < 3) n++;
    print n;
    do {
        n--;
    } while (n > 0);
    print n;
    do { n++; } while (n < 0);
    print n;
    repeat {
        n += 2;
    } until n >= 6
    print n;
    repeat 3 times n++;
    print n;
    var letters = "";
    foreach (var ch in "abc") letters &= upper(ch);
    print letters;
    foreach (x in [1, 2, 3]) {
        if (x == 2) continue;
        print x;
    }
    for each y in [4, 5] print y;
    var guard = 0;
    for (;;) {
        guard++;
        if (guard >= 4) break;
    }
    print guard;

    // switch: each case ends by itself
    foreach (var v in [1, 2, 3, "4", 5, "x"]) {
        switch (v) {
            case 1:
                print "one";
            case 2: case 3:
                print "two or three";
                break;
            case 4, 5: print "four or five";
            default:
                print "other: " + v;
        }
    }
    var shown = "";
    for (var w = 0; w < 6; w++) {
        switch (w % 3) {
            case 0: continue;
            case 1:
                if (w > 3) break;
                shown &= w;
        }
        shown &= ".";
    }
    print shown;
    switch ("Abc".toLower()) {
        case "abc": print "lower";
    }
    print Math.PI.round(3);
    print Math.floor(7.9) + Math.abs(-2);

    // methods
    var name = "  Ana Maria  ";
    print name.trim();
    print name.trim().length();
    print name.trim().length;
    print "Wemazy".size;
    print "Wemazy".toUpper();
    print "Wemazy".toLowerCase();
    print "Wemazy".contains("MAZ");
    print "Wemazy".startsWith("we");
    print "Wemazy".endsWith("zy");
    print "".empty();
    print "  ".isEmpty();
    print "x".empty();
    print [].empty();
    print isEmpty(nothing);
    print empty([1]);
    print contains([1, 2], 2);
    print startsWith("abc", "A");
    print endsWith("abc", "bc");
    print "a-b-c".replace("-", "+");
    print "a,b".split(",").join(" & ");
    print "Wemazy".substring(1, 2);
    print "banana".indexOf("n");
    print (12).toString() & "!";
    print "12".toNumber() + 1;
    print 3.14159.round(2);
    print Math.round(2.5);
    print Math.max(3, 9, 4);
    print Math.sqrt(16);
    print [3, 1, 2].sum();
    print [3, 1, 2].max();
    print [3, 1, 2].first();
    print [3, 1, 2].last();
    print [3, 1, 2].count();
    print [3, 1, 2].length;
    print 7.5.toFixed(2);
    print 21.double();
    var list = [3, 1, 2];
    list.add(5);
    list.push(0);
    print list;
    list.remove(1);
    print list;
    list.sort();
    print list;
    list.reverse();
    print list;
    list = [1, 1, 2, 2];
    list.unique();
    print list;
    list.clear();
    print list;
    print list.length;
    print nothing.length;
    print null.count;
    var word = " hello ";
    word.trim();
    word.toUpper();
    print word;
    var pet = {
        name: "Rex",
        age: 3,
    };
    print pet.name;
    print pet.keys();
    print pet.has("age");
    print pet.count;
    pet.age++;
    pet.age += 1;
    print pet.age;
    var marks = [1, 2, 3];
    marks[2] *= 10;
    print marks;
    console.log("log", 1, true);

    // errors
    try {
        print 1 / 0;
    } catch (e) {
        print "caught: " + e;
    }
    try {
        print fromJson('{bad');
    } catch (Exception ex) {
        print "caught 2: " & (ex.length > 0);
    }
    try {
        print [1].nothingHere;
    } catch {
        print "caught 3: " & error;
    }
    print fact(10);
    print sumTo(100);
}

server function double(x) {
    return x * 2;
}

server function fact(n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

/* a note
   on more lines */
server function sumTo(n)
{
    var total = 0;
    for (var i = 1; i <= n; i++) total += i;
    return total;
}
