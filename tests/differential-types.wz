server function Point moved(Point p) {
    p.x += 1;
    return p;
}

server function int32 countLegs(Animal[] list) {
    int32 n = 0;
    foreach (Animal a in list) n += a.legs;
    return n;
}

server function int32 maxOf(int32 a, int32 b) {
    if (a > b) return a;
    return b;
}

server function string greet(string name, int32 times) {
    string out = "";
    for (int32 k = 1; k <= times; k++) out += name[1];
    return out + "!";
}

server function float32 half2(int32 n) {
    return n / 2;
}
