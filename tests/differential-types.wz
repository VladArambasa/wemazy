// Types, structs, unions and classes. Every line printed here must be the same in JavaScript and in PHP.
struct Point {
    int32 x;
    int32 y;
}
struct Player {
    string name;
    int32 score = 10;
    Point pos;
    float32 speed = 1.5;
}
union Number {
    int32 i;
    float32 f;
    uint8 b;
}
interface IShape {
    float64 area();
    string name();
}
abstract class Shape : IShape {
    protected string label;
    public static int32 made = 0;
    Shape(string label) {
        this.label = label;
        made++;
    }
    public string name() { return label; }
    public abstract float64 area();
    public virtual string describe() { return name() + " with area " + area(); }
}
class Circle : Shape {
    private float64 r;
    public Circle(float64 r) : base("circle") { this.r = r; }
    public override float64 area() { return 3 * r * r; }
}
class Rect : Shape {
    int32 w, h;
    public Rect(int32 w, int32 h) : base("rect") {
        this.w = w;
        this.h = h;
    }
    public override float64 area() { return w * h; }
    public override string describe() { return "Rect " + w + "x" + h + ": " + base.describe(); }
}
class Square extends Rect {
    public Square(int32 side) {
        super(side, side);
        label = "square";
    }
}
class Counter {
    public static int32 count;
    public int32 value;
    public const int32 MAX = 3;
    public readonly string id;
    public Counter(string id) { this.id = id; count++; }
    public void add(int32 n) {
        value += n;
        if (value > MAX) value = MAX;
    }
    public static int32 twice(int32 n) { return n * 2; }
    public int32 get() { return value; }
}
class Node {
    public int32 val;
    public Node next;
}
class Animal {
    public string name = "?";
    public int32 legs = 4;
    public virtual string sound() { return "..."; }
    public string speak() { return name + " says " + sound(); }
}
class Dog : Animal {
    public Dog(string n) { name = n; }
    public override string sound() { return "woof"; }
}
class Bird : Animal {
    public Bird() { name = "bird"; legs = 2; }
    public override string sound() { return "tweet"; }
}

